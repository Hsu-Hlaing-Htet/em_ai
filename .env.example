# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2048

# Laravel backend — data source for grounding answers
BACKEND_BASE_URL=http://127.0.0.1:8000/api
BACKEND_TIMEOUT_SECONDS=15

# Service
APP_NAME=rosewood-ai
LOG_LEVEL=INFO
# Optional shared secret for server-to-server calls from Laravel (X-Rosewood-AI-Internal-Key)
# AI_INTERNAL_KEY=

# Comma-separated CORS origins (only needed for direct browser access; Rosewood uses Laravel proxy)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
